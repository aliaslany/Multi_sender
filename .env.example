SEARCH_CITY_IDS=823,1996,1999
SEARCH_CATEGORY=real-estate

# Which source to poll: divar (default) or telegram_relay
SOURCE_TYPE=divar

# Configure at least one destination.
BOT_TOKEN=
BOT_CHATID=
BALE_BOT_TOKEN=
BALE_CHATID=
RUBIKA_BOT_TOKEN=
RUBIKA_CHATID=
EITAA_TOKEN=
EITAA_CHATID=

# Required only when SOURCE_TYPE=telegram_relay - comma-separated chat ids
# allowed to post through the relay (your user id and/or a channel id).
TELEGRAM_RELAY_CHAT_IDS=

# Optional, telegram_relay only: "follow us elsewhere" footer on every
# relayed post. Leave a *_CHANNEL_URL empty to omit that platform.
CHANNEL_LINK_LABEL=طبیعت+
TELEGRAM_CHANNEL_URL=https://t.me/nature_plus
BALE_CHANNEL_URL=https://ble.ir/natureplus
RUBIKA_CHANNEL_URL=https://rubika.ir/natureplus1

# Override only if you want a different quotes dataset/theme.
NATURE_QUOTES_URL=https://cdn.jsdelivr.net/gh/aliaslany/persian-quotes@main/data/quotes/tabiat.json
NATURE_QUOTES_FALLBACK_URL=https://raw.githubusercontent.com/aliaslany/persian-quotes/main/data/quotes/tabiat.json

# Override only when using a compatible gateway or a changed platform endpoint.
BALE_API_BASE_URL=https://tapi.bale.ai
RUBIKA_API_BASE_URL=https://botapi.rubika.ir/v3
EITAA_API_BASE_URL=https://eitaayar.ir/api
MESSENGER_REQUEST_TIMEOUT=30
